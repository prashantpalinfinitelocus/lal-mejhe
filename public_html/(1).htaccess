Options -Indexes

<FilesMatch "\.(sql|log)$">
  Require all denied
</FilesMatch>

# V102 security hardening
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always unset X-Powered-By

  # V102.7 - Enforced Content Security Policy
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://wa.me https://api.whatsapp.com; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://www.gstatic.com https://maps.googleapis.com https://maps.gstatic.com https://maxcdn.bootstrapcdn.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://maxcdn.bootstrapcdn.com; font-src 'self' https://fonts.gstatic.com https://maxcdn.bootstrapcdn.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://www.googletagmanager.com https://maps.googleapis.com https://maps.gstatic.com; frame-src 'self' https://www.google.com https://maps.google.com; media-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self';"
</IfModule>

# Never expose environment/config/log/backup files
<FilesMatch "^(\.env|config\.php|config\.sample\.php|.*\.(log|sql|bak|ini))$">
  Require all denied
</FilesMatch>

# V102.1 diagnostic log protection
RedirectMatch 403 ^/logs(?:/|$)

# V102.6: never execute server-side scripts from uploaded image storage
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^uploads/.*\.(?:php|php[0-9]?|phtml|phar)$ - [F,L,NC]
</IfModule>